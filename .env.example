# =================================================================
# MySQL Database Configuration
# =================================================================
# root 사용자의 비밀번호
MYSQL_ROOT_PASSWORD=your_root_password_here

# 초기 생성할 데이터베이스 명
MYSQL_DATABASE=modern_bank

# 애플리케이션에서 사용할 DB 계정 정보
MYSQL_USER=your_db_username_here
MYSQL_PASSWORD=your_password_here

# =================================================================
# Spring Boot Datasource Configuration
# =================================================================
# 도커 환경에서는 db:3306, 로컬 환경에서는 localhost:3306 사용
DB_URL=jdbc:mysql://db:3306/modern_bank?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_password_here

# =================================================================
# Security & JWT Configuration
# =================================================================
# JWT 토큰 서명에 사용할 Secret Key
JWT_SECRET=your_jwt_secret_key_random_string_here